[Unit]
Description=Spyder Serial Bridge config web GUI
Documentation=https://github.com/jasonwines/spyder-serial-bridge
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=spyder-bridge
Group=spyder-bridge
Environment=PYTHONPATH=/opt/spyder-bridge/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m spyder_bridge.web --config /etc/spyder-bridge/config.yaml --host 0.0.0.0 --port 80
Restart=always
RestartSec=5

# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. The config directory is the only writable path, which is also
# the only thing that must stay writable under an eventual read-only root.
# /dev stays visible so the page can list detected serial adapters.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/spyder-bridge
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
